    character: GINA
    image: {fileID: 0}
    answers:
    - text: "Ci prover\xF2"
      link: 138
      condition: 0
      effect: 0
    - text: No
      link: 140
      condition: 0
      effect: 0
  - text: "Vedr\xF2 cosa posso fare."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 139
      condition: 0
      effect: 0
  - text: Ottima scelta.
    character: GINA
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 0
  - text: Onestamente, preferirei di no.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 141
      condition: 0
      effect: 0
  - text: Fa come vuoi.
