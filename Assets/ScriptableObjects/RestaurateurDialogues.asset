%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d8706b4ba0acba8499f61c8814f382a5, type: 3}
  m_Name: RestaurateurDialogues
  m_EditorClassIdentifier: 
  dialogues:
  - text: Ciao Brian. Hai pesci da vendermi oggi?
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: "S\xEC, certamente."
      link: 1
      condition: 0
      effect: 0
    - text: No, non oggi.
      link: 2
      condition: 0
      effect: 0
  - text: Ottimo, vediamo un po' cosa hai da offrirmi.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 1000
      condition: 0
      effect: 0
  - text: "Non c'\xE8 problema, me ne porterai altri la prossima volta."
    character: FAUSTO
    image: {fileID: 0}
    answers: []
  - text: Grazie di tutto Brian, alla prossima!
    character: FAUSTO
    image: {fileID: 0}
    answers: []
  - text: Comunque, hai dei pesci da vendermi?
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: "S\xEC, certamente."
      link: 1
      condition: 0
      effect: 0
    - text: No, non oggi.
      link: 2
      condition: 0
      effect: 0
  - text: "Buonasera. \xC8 lei il ristoratore di quest'isola?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 6
      condition: 0
      effect: 0
  - text: "Buonasera. S\xEC sono io. Mi dispiace ma il ristorante \xE8 chiuso a quest'ora.
      Se vuoi per\xF2 domani siamo aperti, dalle 10:00 alle 23:00, come tutti gli
      altri giorni della settimana."
    character: RISTORATORE
    image: {fileID: 0}
    answers:
    - text: "Lavora cos\xEC tanto?"
      link: 7
      condition: 0
      effect: 0
    - text: Non sono un cliente
      link: 10
      condition: 0
      effect: 0
  - text: "Lavora cos\xEC tanto tutti i giorni? Eppure non mi sembra arrivi cos\xEC
      tanta gente su quest'isola."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 8
      condition: 0
      effect: 0
  - text: "Ragazzo, l'apparenza inganna. Le persone conoscono il mio ristorante e
      sanno che se vengono a mangiare da me rimarranno soddisfatte! Per questo ho
      sempre abbastanza clienti da mantenere attiva l'attivit\xE0."
    character: RISTORATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 9
      condition: 0
      effect: 0
  - text: Comunque... Io non sono venuto qui come cliente. Mi hanno detto che lei
      potrebbe essere interessato all'acquisto di pesci.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 11
      condition: 0
      effect: 0
  - text: "In realt\xE0 io non sono qui per mangiare. Mi hanno detto che lei potrebbe
      essere interessato all'acquisto di pesci."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 11
      condition: 0
      effect: 0
  - text: "Non sono interessato ragazzo. Sono gi\xE0 in affari con il pescatore di
      quest'isola."
    character: RISTORATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 12
      condition: 0
      effect: 0
  - text: Sono stato mandato qui proprio da lui. Lo sostituisco a lavoro per un po'
      di tempo.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 13
      condition: 0
      effect: 0
  - text: Davvero? Si vede che quell'uomo non ha una famiglia da mantenere...
    character: RISTORATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 14
      condition: 0
      effect: 0
  - text: Ah, che scortese! Non mi sono presentato! Io sono Fausto, tu invece come
      ti chiami?
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 15
      condition: 0
      effect: 0
  - text: Mi chiamo Brian.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 16
      condition: 0
      effect: 0
  - text: Brian... Insomma, vediamo un po' che pesci hai da offrirmi.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 1000
      condition: 0
      effect: 0
  - text: "Ottimo Brian. \xC8 la prima volta che fai il pescatore?"
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 18
      condition: 0
      effect: 0
  - text: "Come lavoro s\xEC, prima era solo un hobby per me."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 19
      condition: 0
      effect: 0
  - text: "Capisco... Allora sar\xE0 difficile per te ricordarti i prezzi di vendita
      dei pesci di queste zone."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 20
      condition: 0
      effect: 0
  - text: "Gi\xE0, non sono molto bravo in queste cose."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 21
      condition: 0
      effect: 0
  - text: "Non ti preoccupare, posso aiutarti. Ecco, prendi questo. \xC8 una lista
      dei prezzi dei pesci di queste zone, cos\xEC le prossime volte saprai quanti
      soldi posso darti per ogni pesce."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 22
      condition: 0
      effect: 0
  - text: Grazie mille Fausto!
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 23
      condition: 0
      effect: 6
  - text: "Ora sar\xE0 meglio che tu vada a letto, altrimenti domani rischi di essere
      meno produttivo."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 2000
      condition: 0
      effect: 8
  - text: Ciao Brian. Il pesce che mi hai venduto la scorsa volta era eccezionale.
      Devi essere un pescatore professionista.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 25
      condition: 0
      effect: 0
  - text: "Grazie, ma non mi definirei proprio un professionista. Ho sempre praticato
      la pesca per hobby, e solo di recente \xE8 diventato il mio lavoro."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 26
      condition: 0
      effect: 0
  - text: "Buon per te, per\xF2 da quel che ho capito \xE8 solo un lavoro temporaneo.
      Hai intenzione di andartene da quest'isola?"
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: "S\xEC, esatto"
      link: 27
      condition: 0
      effect: 0
    - text: Sono indeciso
      link: 31
      condition: 4
      effect: 0
  - text: "S\xEC sto cercando di accumulare monete per riprendere il mio viaggio.
      Lo devo alla mia famiglia."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 28
      condition: 0
      effect: 0
  - text: "Ti capisco perfettamente Brian, la famiglia viene prima di tutto. \xC8
      proprio per la famiglia che continuo a lavorare in questo ristorante."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 29
      condition: 0
      effect: 0
  - text: Fin da giovane ho sempre avuto la passione di fare il marinaio...
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 30
      condition: 0
      effect: 0
  - text: Mi ha sempre affascinato l'idea di viaggiare sul mare verso luoghi sconosciuti,
      con il vento che ti accarezza i capelli e le onde che cantano in armonia sotto
      lo splendore del sole e della luna.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 34
      condition: 0
      effect: 0
  - text: "In realt\xE0 sono un po' indeciso al riguardo."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 32
      condition: 0
      effect: 0
  - text: Non conosco la tua situazione familiare, ma se accetti un consiglio da
      parte mia, torna dai tuoi cari.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 33
      condition: 0
      effect: 0
  - text: "Se c'\xE8 una cosa che imparerai da grande \xE8 che la famiglia \xE8 tutto.
      \xC8 proprio per la famiglia che continuo a lavorare in questo ristorante."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 29
      condition: 0
      effect: 0
  - text: Ma crescendo ho capito che questo sogno era meglio se restava nelle mie
      fantasie.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 35
      condition: 0
      effect: 0
  - text: "Il vuoto che si crea dentro di te quando spezzi i legami con la tua famiglia
      non \xE8 colmabile da un semplice sogno."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: Forse hai ragione
      link: 36
      condition: 0
      effect: 0
    - text: Non credo...
      link: 38
      condition: 0
      effect: 0
  - text: Potresti aver ragione. Non posso rischiare di mandare in rovina la mia
      famiglia. Devo continuare il mio viaggio il prima possibile.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 37
      condition: 0
      effect: 2
  - text: Ben detto Brian.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 0
  - text: "Non ne sarei cos\xEC sicuro. Insomma, dipende dalla propria situazione
      familiare."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 39
      condition: 0
      effect: 0
  - text: Crescendo mi capirai.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 0
  - text: "Ciao Brian, i clienti si sono complimentati per la qualit\xE0 del pesce,
      per questo volevo ringraziarti."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 41
      condition: 0
      effect: 0
  - text: Grazie a te Fausto. Sei sempre stato generoso con me quando si trattava
      di soldi.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 42
      condition: 0
      effect: 0
  - text: Ho imparato ad essere gentile con chi se lo merita.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 43
      condition: 0
      effect: 0
  - text: Dunque, so che non c'entra molto, ma la prima volta che ti incontrai pensai
      a quanto fosse strano sentire un ragazzo di nome Brian da queste parti.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 44
      condition: 0
      effect: 0
  - text: Te di preciso di dove sei originario?
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 45
      condition: 0
      effect: 0
  - text: "Io sono di Canciulle, una localit\xE0 sul mare a Sud della penisola Cassiana.
      Il mio nome per\xF2 non \xE8 di quelle parti, e onestamente non so perch\xE9
      i miei genitori mi abbiano chiamato cos\xEC."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 46
      condition: 0
      effect: 0
  - text: "Ma come!? Non ti \xE8 mai venuto in mente di chiederglielo?"
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 47
      condition: 0
      effect: 0
  - text: "Sfortunatamente non ho mai avuto l'occasione di chiederglielo. \xC8 da
      quando ho ricordo che vivo con i miei zii e mio nonno. L'unica risposta che
      ottengo quando chiedo informazioni sui miei genitori \xE8 il silenzio."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 48
      condition: 0
      effect: 0
  - text: Deve essere un argomento delicato per la tua famiglia.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 49
      condition: 0
      effect: 0
  - text: "S\xEC, decisamente. Io ormai ci ho fatto l'abitudine, ma loro non riescono
      ad andare avanti."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 50
      condition: 0
      effect: 0
  - text: "Ed ora che sei scappato di casa chiss\xE0 quanto staranno soffrendo."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 51
      condition: 0
      effect: 0
  - text: Ti stai facendo un'idea sbagliata. Non sono scappato di casa, anzi sono
      stati i miei zii a mandarmi in mare.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 52
      condition: 0
      effect: 0
  - text: "Cosa? Perch\xE9 mai avrebbero fatto una cosa del genere?"
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: Devo trovare il nonno
      link: 53
      condition: 0
      effect: 0
    - text: Sono attaccati ai soldi
      link: 67
      condition: 4
      effect: 0
  - text: Mi hanno affidato il compito di ritrovare il nonno. Da quel che so dovrebbe
      trovarsi sull'isola Mercatella.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 54
      condition: 0
      effect: 0
  - text: "Cos\xEC stai accumulando soldi per continuare il tuo viaggio..."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: In teoria...
      link: 55
      condition: 3
      effect: 0
    - text: Esatto
      link: 63
      condition: 0
      effect: 0
  - text: "In realt\xE0 devo ancora capire quali sono i miei piani."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 56
      condition: 0
      effect: 0
  - text: Ma come?! Non hai intenzione di trovare tuo nonno?
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 57
      condition: 0
      effect: 0
  - text: "S\xEC, le mie intenzioni sarebbero quelle, per\xF2 c'\xE8 qualcosa che
      mi blocca."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 58
      condition: 0
      effect: 0
  - text: Hai idea di cosa possa essere? Posso aiutarti in qualche modo?
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 59
      condition: 0
      effect: 0
  - text: Penso che abbia a che fare con i miei zii. Non ho tanta voglia di tornare
      da loro una volta finito questo viaggio.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 60
      condition: 0
      effect: 0
  - text: "Mh... Comunque non mi sembra un'ottima scusa per lasciare tuo nonno disperso
      in mare. Personalmente ti consiglio intanto di trovare il tuo caro nonnino,
      cos\xEC che insieme possiate scegliere cosa fare riguardo i tuoi zii."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 61
      condition: 0
      effect: 0
  - text: "\xC8 pur sempre tuo nonno, no?"
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 62
      condition: 0
      effect: 0
  - text: Hai ragione Fausto
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 0
  - text: "Hai gi\xE0 capito tutto."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 64
      condition: 0
      effect: 0
  - text: "Prego per te cos\xEC che tu possa ritrovare il tuo povero nonno."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 65
      condition: 0
      effect: 0
  - text: Ecco, tieni. Un compenso extra. Questo tuo viaggio ha la mia piena approvazione.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 66
      condition: 0
      effect: 11
  - text: Wow... Non so che dire Fausto... Grazie!
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 2
  - text: "Perch\xE9 sono troppo attaccati ai soldi."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 68
      condition: 0
      effect: 0
  - text: Spiegati meglio...
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 69
      condition: 0
      effect: 0
  - text: "Mi hanno mandato a cercare il nonno in mare, ma non perch\xE9 fossero
      interessati alla sua vita. Quello che gli interessa \xE8 la sua pensione!"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 70
      condition: 0
      effect: 0
  - text: Forse hai semplicemente inteso male la loro arroganza. Magari stanno solo
      mascherando la loro sofferenza.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 71
      condition: 0
      effect: 0
  - text: "Non penso proprio Fausto. \xC8 da anni che li conosco, e non si sono mai
      interessati a me. Non mi hanno mai dimostrato affetto o gratitudine durante
      dopo tutti questi anni in cui ho lavorato nel loro negozio!"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 72
      condition: 0
      effect: 0
  - text: "Io invece penso di s\xEC. Rifletti, magari hanno paura di perdere tuo
      nonno dopo che hanno perso i tuoi genitori, e hanno preferito nasconderti questo
      dolore."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 73
      condition: 0
      effect: 0
  - text: Non tutti siamo sensibili allo stesso modo, e non tutti siamo disposti
      a condividere le proprie emozioni con gli altri, specialmente se le emozioni
      sono negative.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 74
      condition: 0
      effect: 0
  - text: "A mio parere dovresti dargli una seconda possibilit\xE0, soprattutto a
      loro che sono la tua famiglia."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: Non saprei...
      link: 75
      condition: 0
      effect: 2
    - text: Non li conosci
      link: 77
      condition: 0
      effect: 0
  - text: "Non lo so Fausto, \xE8 complicato."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 76
      condition: 0
      effect: 0
  - text: Non ti preoccupare, hai ancora tempo per rifletterci.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 0
  - text: Mi dispiace Fausto, tu non li conosci come li conosco io.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 78
      condition: 0
      effect: 0
  - text: Ti chiedo solo di rifletterci un po' su.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 0
  - text: Ciao Brian, anche i pesci della scorsa volta erano ottimi.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 80
      condition: 0
      effect: 0
  - text: "Mi fa piacere Fausto. Piuttosto, \xE8 dall'altro giorno che volevo chiederti
      una cosa..."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 81
      condition: 0
      effect: 0
  - text: Di che si tratta?
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 82
      condition: 0
      effect: 0
  - text: A te piace effettivamente lavorare in questo ristorante su quest'isola?
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 83
      condition: 0
      effect: 0
  - text: "Quello che mi piace non \xE8 importante, la mia famiglia lo \xE8, te l'ho
      gi\xE0 detto, no?"
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 84
      condition: 0
      effect: 0
  - text: Quindi sei disposto ad abbandonare il tuo sogno per restare con la tua
      famiglia?
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 85
      condition: 0
      effect: 0
  - text: Mi sembra ovvio, no?
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 86
      condition: 0
      effect: 0
  - text: Ma chi ti dice che facendo il marinaio abbandoneresti la tua famiglia?
      Una cosa non esclude l'altra!
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 87
      condition: 0
      effect: 0
  - text: "Sei ancora troppo giovane per capirlo. La vita a volte ci mette davanti
      a delle scelte difficili: sta a noi scegliere la via pi\xF9 saggia e responsabile."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 88
      condition: 0
      effect: 0
  - text: Nel mio caso, ho scelto di fare un lavoro che non mi piace per stare con
      la mia famiglia e mantenerla economicamente.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 89
      condition: 0
      effect: 0
  - text: "Ma perch\xE9 non fare il marinaio?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 90
      condition: 0
      effect: 0
  - text: Conosci i modi di dire, no? "Chi sposa il mare sposa la solitudine", "Il
      pescatore parla con il vento non con le persone".
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: ...
      link: 91
      condition: 0
      effect: 0
    - text: Sono modi di dire
      link: 97
      condition: 0
      effect: 0
  - text: '"Sposare la solitudine"...'
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 92
      condition: 0
      effect: 0
  - text: "Proprio cos\xEC Brian. Pensaci un po' su. Torna dalla tua famiglia, in
      fondo gli devi la tua vita. Sono le persone che ti hanno cresciuto."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: "Certo, lo far\xF2"
      link: 93
      condition: 1
      effect: 2
    - text: Non conosci i miei zii
      link: 95
      condition: 3
      effect: 0
  - text: "Appena avr\xF2 abbastanza soldi lo far\xF2, non ti preoccupare Fausto."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 94
      condition: 0
      effect: 0
  - text: Sono fiero di te, Brian.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 0
  - text: "Tu non conosci la mia famiglia. Probabilmente ora che non sono pi\xF9
      a casa sentiranno solo la mancanza di qualcuno che gli metta a posto il magazzino
      del negozio."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 96
      condition: 0
      effect: 0
  - text: Crescendo imparerai ad apprezzare anche i loro difetti.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 0
  - text: Eppure in questo momento io sto parlando con te.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 98
      condition: 0
      effect: 0
  - text: "Pff... Arriver\xE0 il giorno in cui mi capirai, Brian."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 0
  - text: "Ciao Brian. Il tuo pescato non smette mai di stupirmi, \xE8 sempre tutto
      eccezionale!"
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 100
      condition: 0
      effect: 0
  - text: Beh, sto solo mettendo in pratica quello che mi ha insegnato il nonno riguardo
      la pesca.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 101
      condition: 0
      effect: 0
  - text: "Tuo nonno... Non lo conosco di persona; mi \xE8 stato detto che \xE8 stato
      un po' di tempo fa su quest'isola."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 102
      condition: 0
      effect: 0
  - text: Immagino ti stia particolarmente a cuore. Ti sei imbarcato in mare da solo
      pur di ritrovarlo, no?
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: Un po' mi manca
      link: 103
      condition: 5
      effect: 0
    - text: Non saprei...
      link: 114
      condition: 3
      effect: 0
  - text: "In effetti un po' mi manca. Non \xE8 di certo la persona migliore di questo
      mondo, perdipi\xF9 non dimostra mai di voler bene a qualcuno. Tuttavia \xE8
      l'unico membro della mia famiglia che mi abbia trattato con dignit\xE0..."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 104
      condition: 0
      effect: 0
  - text: Intendiamoci, a modo suo.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 105
      condition: 0
      effect: 0
  - text: "Certo, ogni uomo su questo pianeta ha un modo a s\xE9 per esporre i propri
      sentimenti."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 106
      condition: 0
      effect: 0
  - text: "Ricordo ancora quella volta che andammo a pescare insieme in uno dei mari
      a Sud della nostra penisola. Era un periodo pessimo per pescare. Ora che ci
      penso, chiss\xE0 perch\xE9 andammo a pescare proprio in quei giorni..."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 107
      condition: 0
      effect: 0
  - text: "Insomma, ricordo che quella volta riuscii a prendere un tonno cos\xEC
      grosso che, quando lo tirai su, mio nonno salt\xF2 dalla paura. Hehe..."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 108
      condition: 0
      effect: 0
  - text: Doveva essere parecchio grosso!
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 109
      condition: 0
      effect: 0
  - text: "Eccome se lo era! Comunque, poco dopo, mio nonno si riprese e mi disse
      \"Per\xF2, non sei male come pescatore. Di questo passo potresti diventare
      anche meglio di me!\"."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 110
      condition: 0
      effect: 0
  - text: "Quella fu la cosa pi\xF9 carina che mi abbia detto in tutta la mia vita,
      e non la dimenticher\xF2 mai."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 111
      condition: 0
      effect: 0
  - text: "Gi\xE0, non c'\xE8 nulla che ti possa rendere felice quanto l'approvazione
      dei tuoi familiari."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 112
      condition: 6
      effect: 0
    - text: 
      link: 4
      condition: 2
      effect: 0
  - text: "Fausto... Pensi che riuscir\xF2 a trovare mio nonno?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 113
      condition: 0
      effect: 0
  - text: "Certo Brian, con le tue grandi capacit\xE0 di navigazione e la consapevolezza
      che si trovi a Mercatella, non avrai nessuno problema, te lo posso assicurare."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 0
  - text: "Il rapporto con mio nonno \xE8 un po' particolare. Non penso che mi manchi
      la sua presenza, per\xF2 non posso neanche dire di non volergli bene."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 115
      condition: 0
      effect: 0
  - text: In che modo dovrebbe essere particolare il vostro rapporto?
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 116
      condition: 0
      effect: 0
  - text: "\xC8 difficile per me capire quanto bene mi voglia mio nonno. Non mi ha
      mai rassicurato, mi offendeva continuamente, e non mi dimostrava mai affetto.
      Raramente ricevevo dei complimenti da parte sua."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 117
      condition: 0
      effect: 0
  - text: "Sono sicuro che ti voglia bene, in fondo sei suo nipote. Ogni essere umano
      dimostra a modo suo ci\xF2 che prova per gli altri. Magari tuo nonno vuole
      sembrare un duro e si comporta da tale."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: Non saprei...
      link: 118
      condition: 0
      effect: 0
    - text: Non credo proprio
      link: 120
      condition: 0
      effect: 0
  - text: "Non saprei Fausto... Forse? \xC8 un tipo strano mio nonno, \xE8 difficile
      per me capirlo."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 119
      condition: 0
      effect: 0
  - text: Non ti preoccupare, glielo chiederai quando lo ritroverai a Mercatella.
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 0
  - text: "Se veramente mi voleva bene, perch\xE9 mi ha lasciatocon gli zii da solo?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 121
      condition: 0
      effect: 0
  - text: "Non direi che ti ha abbandonato, anche perch\xE9 ti ha lasciato scritto
      dove andava, no? Chiss\xE0, magari aveva gi\xE0 pensato che tu saresti andato
      a cercarlo."
    character: FAUSTO
    image: {fileID: 0}
    answers:
    - text: 
