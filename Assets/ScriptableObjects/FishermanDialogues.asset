%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 67428d3c96865a84aa2c4c70369c4df6, type: 3}
  m_Name: FishermanDialogues
  m_EditorClassIdentifier: 
  dialogues:
  - text: Ugh... Dove mi trovo?
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 1
      condition: 0
      effect: 0
  - text: "Sei sull'isola di Spedula. Non mi sembri un uomo di mare: navighi come
      un ritardato, e il mare si \xE8 preso gioco di te."
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 2
      condition: 0
      effect: 0
  - text: "Dov'\xE8 adesso la mia barca?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 3
      condition: 0
      effect: 0
  - text: "Figliolo, sei naufragato. La tua barca si \xE8 distrutta per colpa delle
      tue manovre da dilettante. Ti ho visto con il mio canocchiale."
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 4
      condition: 0
      effect: 0
  - text: "Distrutta?! Questo non ci voleva. Come far\xF2 a trovare mio nonno in
      mare senza una barca?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 5
      condition: 0
      effect: 0
  - text: "Giusto una curiosit\xE0 figliolo... Te da dove arrivi?"
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 6
      condition: 0
      effect: 0
  - text: "Beh, vengo da Canciulle, una localit\xE0 sul mare a Sud della penisola
      Cassiana."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 7
      condition: 0
      effect: 0
  - text: Mh... Se non ricordo male qualche mese fa giunse su quest'isola un vecchio
      che veniva proprio da quelle parti.
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 8
      condition: 0
      effect: 0
  - text: "Aspetti... Un vecchio? Potrebbe essere mio nonno! Sa se quel vecchio \xE8
      su quest'isola?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 9
      condition: 0
      effect: 0
  - text: "No, penso che sia gi\xE0 partito. Non ci ho interagito molto, ma da quel
      che so voleva andare in una delle isole pi\xF9 vicine."
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 10
      condition: 0
      effect: 0
  - text: "Mercatella! \xC8 veramente vicina a quest'isola?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 11
      condition: 0
      effect: 0
  - text: "Ho detto che \xE8 una delle pi\xF9 vicine, non che sia effettivamente
      vicina."
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 12
      condition: 0
      effect: 0
  - text: Allora come faccio a raggiungerla senza una barca?
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 13
      condition: 0
      effect: 0
  - text: 'Semplice: compri una nuova barca da me.'
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 14
      condition: 0
      effect: 0
  - text: "Lei vende barche? Quanto costa quella pi\xF9 economica?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 15
      condition: 0
      effect: 0
  - text: "L'unica che vendo costa 500\u20AC."
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 16
      condition: 0
      effect: 0
  - text: "500\u20AC?! Io ho solo 100\u20AC con me!"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 17
      condition: 0
      effect: 0
  - text: Voi giovani siete senza speranza... Se ti servono soldi, inizia a lavorare!
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 18
      condition: 0
      effect: 0
  - text: "C'\xE8 qualcuno che mi potrebbe assumere su quest'isola?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 19
      condition: 0
      effect: 0
  - text: Certo, io. Mi puoi sostituire come pescatore dell'isola. La mattina ti
      svegli e vai in mare a pescare, cercando di non distruggere di nuovo la barca,
      e la sera vendi i pesci al ristorante qui vicino.
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 20
      condition: 0
      effect: 0
  - text: "Vedrai che accumulerai 500\u20AC in poco tempo."
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 21
      condition: 0
      effect: 0
  - text: "Non \xE8 una pessima idea. L'unico problema \xE8 che dovr\xF2 rimanere
      su quest'isola per un po'. Non c'\xE8 un altro modo per avere una barca?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 22
      condition: 0
      effect: 0
  - text: "No figliolo, sono l'unico su quest'isola a possedere delle barche. La
      vita \xE8 dura, se vuoi una barca te la devi guadagare!"
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 23
      condition: 0
      effect: 0
  - text: "D'accordo. Conosce qualcuno che mi pu\xF2 offrire un posto dove dormire?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 24
      condition: 0
      effect: 0
  - text: Sono io quello che ospita i turisti su quest'isola. Posso offrirti vitto
      e alloggio.
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 25
      condition: 0
      effect: 0
  - text: Davvero? Grazie del favore signore!
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 26
      condition: 0
      effect: 0
  - text: "Certo, certo. Mi aspetto di essere pagato 100\u20AC per questo favore.
      Inoltre, appena arriva un turista disposto a pagare di pi\xF9, dovrai sloggiare."
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 27
      condition: 0
      effect: 0
  - text: "Ma... 100\u20AC sono tutto quello che ho."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 28
      condition: 0
      effect: 0
  - text: "Vedila cos\xEC: almeno non ti ho fatto pagare il prezzo originale a notte."
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: Va bene
      link: 29
      condition: 0
      effect: 0
    - text: Decisamente no
      link: 34
      condition: 0
      effect: 0
  - text: Va bene. In fondo mi ha salvato la vita.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 30
      condition: 0
      effect: 9
  - text: Ti sbagli. Sono state le onde a portarti a riva, non io.
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 31
      condition: 0
      effect: 0
  - text: Ah...
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 32
      condition: 0
      effect: 0
  - text: "Comunque, la tua capanna \xE8 quella accanto alla mia. Ti conviene entrare
      dentro e riposare. Domani sar\xE0 il tuo primo giorno di lavoro."
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 33
      condition: 0
      effect: 0
  - text: "Certo... Urr\xE0..."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 2000
      condition: 0
      effect: 0
  - text: "Decisamente no. Trover\xF2 qualcun altro su quest'isola che possa ospitarmi.
      Grazie lo stesso."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 35
      condition: 0
      effect: 0
  - text: "Sono l'unico che pu\xF2 offrirti un posto dove riposare. Inoltre non ti
      conviene trattare cos\xEC l'unico uomo su quest'isola che ti pu\xF2 vendere
      una barca."
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 36
      condition: 0
      effect: 0
  - text: "Mh... Va bene, tieni i miei 100\u20AC."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 37
      condition: 0
      effect: 9
  - text: Ottima scelta.
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 32
      condition: 0
      effect: 0
  - text: Mi fa piacere vederti sveglio a quest'ora, in fondo chi dorme non prende
      pesci!
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 39
      condition: 0
      effect: 0
  - text: Ormai sono abituato a svegliarmi a quest'ora. Di solito io la mattina...
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 40
      condition: 0
      effect: 0
  - text: Non mi interessa figliolo.
    character: PESCATORE
    image: {fileID: 0}
    answers:
    - text: 
      link: 41
      condition: 0
      effect: 0
  - text: Brian, mi chiami Brian.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 42
      condition: 0
      effect: 0
  - text: E tu chiamami Furio.
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 43
      condition: 0
      effect: 0
  - text: "Brian, pff... Ti ho gi\xE0 preparato una barca con tutta l'attrezzatura,
      quindi puoi gi\xE0 andare a pescare. Non pensare di potermi rubare la barca
      e fuggire. Ti tengo d'occhio da lontano."
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 2000
      condition: 0
      effect: 0
  - text: Allora, sei pronto per un altro giorno di lavoro?
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: "S\xEC, sono pronto"
      link: 45
      condition: 0
      effect: 0
    - text: "Perch\xE9 tu non lavori?"
      link: 47
      condition: 0
      effect: 0
    - text: "Ho gi\xE0 500\u20AC"
      link: 57
      condition: 9
      effect: 0
  - text: "S\xEC, sento che oggi riuscir\xF2 a pescare pi\xF9 pesci di ieri."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 46
      condition: 0
      effect: 0
  - text: Certo, certo... Cerca di non illuderti.
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 2000
      condition: 0
      effect: 0
  - text: "Certo, ma perch\xE9 lei non lavora? Perch\xE9 mi ha passato questo incarico?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 48
      condition: 0
      effect: 0
  - text: "Perch\xE9 odio il mio lavoro, e penso di meritarmi una pausa."
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 49
      condition: 0
      effect: 0
  - text: Beh, ora mi torna. Che dire...
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 50
      condition: 0
      effect: 0
  - text: Torna a lavorare! Qui non ti pagano all'ora, e neanche con un salario fisso!
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 2000
      condition: 0
      effect: 0
  - text: "Finalmente sei tornato, Brian. Vendi in fretta i tuoi pesci, si \xE8 fatto
      tardi e domattina devi tornare a lavorare."
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: Certamente
      link: 52
      condition: 0
      effect: 0
    - text: "Perch\xE9 tu non lavori?"
      link: 47
      condition: 0
      effect: 0
    - text: "Ho gi\xE0 500\u20AC"
      link: 57
      condition: 9
      effect: 0
  - text: "Certamente, cercher\xF2 di essere veloce."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 53
      condition: 0
      effect: 0
  - text: Vedi di non perderti in chiacchere!
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 2000
      condition: 0
      effect: 0
  - text: Eccoti finalmente! Va velocemente al ristorante qui vicino per vendere
      i pesci!
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 55
      condition: 0
      effect: 13
  - text: "S\xEC certo, ma perch\xE9 tutta questa fretta?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 56
      condition: 0
      effect: 0
  - text: "Perch\xE9 tra poco il ristoratore va a dormire, proprio come dovresti
      fare tu a quest'ora."
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 2000
      condition: 0
      effect: 0
  - text: "In realt\xE0 volevo dirti che ho gi\xE0 accumulato 500\u20AC."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 58
      condition: 0
      effect: 0
  - text: Buon per te Brian. Ti sei meritato la mia barca. Allora te ne vai? Parti
      alla ricerca di tuo nonno?
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: "S\xEC, devo andare"
      link: 59
      condition: 5
      effect: 0
    - text: Ho cambiato piano
      link: 66
      condition: 3
      effect: 0
  - text: "S\xEC, non posso farlo aspettare ancora. Devo portare al termine questo
      viaggio."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 60
      condition: 0
      effect: 0
  - text: Heh, mi stupisce che tu non mi abbia mai rubato la barca per andare da
      tuo nonno.
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 61
      condition: 0
      effect: 0
  - text: Non sono un ladro.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 62
      condition: 0
      effect: 0
  - text: E non sei neanche un tipo furbo.
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 63
      condition: 0
      effect: 0
  - text: "Non c'\xE8 di che..."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 64
      condition: 0
      effect: 0
  - text: Buona fortuna Brian, speriamo che tuo nonno sia ancora vivo.
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 65
      condition: 0
      effect: 0
  - text: Ehm... Grazie...
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 2000
      condition: 0
      effect: 14
  - text: "In realt\xE0 i miei piani sono cambiati. Penso di voler restare su quest'isola."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 67
      condition: 0
      effect: 0
  - text: Non so cosa trovi di interessante in quest'isola, ma chi sono io per giudicare?
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 68
      condition: 0
      effect: 0
  - text: "Pensavo di restare qui come pescatore. Potrei usare questi soldi per avviare
      la mia attivit\xE0 di pesca."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 69
      condition: 0
      effect: 0
  - text: "Ma per favore... Dammi questi 500\u20AC e diventerai ufficialmente il
      pescatore di quest'isola."
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 70
      condition: 0
      effect: 0
  - text: Non penso di aver inteso.
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 71
      condition: 0
      effect: 0
  - text: "Ah... Sciocco Brian. Ti sto cedendo la mia attivit\xE0 di pesca. Sono
      stufo di questo lavoro, e penso di meritarmi una pensione a quest'et\xE0."
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: "Non \xE8 cos\xEC vecchio"
      link: 72
      condition: 0
      effect: 0
    - text: Grazie mille
      link: 78
      condition: 0
      effect: 0
  - text: "Non \xE8 troppo giovane per andare in pensione?"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 73
      condition: 0
      effect: 0
  - text: Fatti gli affari tuoi, piuttosto va a festeggiare da qualche parte, lontano
      da qui.
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 74
      condition: 0
      effect: 0
  - text: "S\xEC, assolutamente. Grazie di tutto Furio, non so veramente come posso
      sdebitarmi!"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 75
      condition: 0
      effect: 0
  - text: "Sar\xE0 meglio che vada, o tutte queste smancerie mi faranno vomitare."
    character: FURIO
    image: {fileID: 0}
    answers:
    - text: 
      link: 76
      condition: 0
      effect: 0
  - text: "Allora \xE8 fatta. Ora posso finalmente capire cosa significa avere lo
      spirito libero."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 77
      condition: 0
      effect: 0
  - text: "Chiss\xE0 come se la star\xE0 passando il nonno..."
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 2000
      condition: 0
      effect: 15
  - text: "Non so realmente come ringraziarla! \xC8 estremamente generoso da parte
      sua!"
    character: BRIAN
    image: {fileID: 0}
    answers:
    - text: 
      link: 75
      condition: 0
      effect: 0
